{
  "type": "object",
  "required": ["event_name", "date", "guest_count", "venue", "schedule", "people", "seating", "catering",
               "menu_cards", "music", "photographer", "contingency", "budget", "venue_notes"],
  "properties": {
    "event_name": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "guest_count": {"type": "integer"},
    "venue": {"type": "object", "required": ["name", "ceremony_location", "cocktail_location"],
              "properties": {"name": {"type": "string"}, "ceremony_location": {"type": "string"},
                             "cocktail_location": {"type": "string"}}},
    "schedule": {"type": "object", "required": ["ceremony_start", "cocktails_start", "dinner_start", "last_shuttle"],
                 "properties": {"ceremony_start": {"$ref": "#/$defs/hhmm"}, "cocktails_start": {"$ref": "#/$defs/hhmm"},
                                "dinner_start": {"$ref": "#/$defs/hhmm"}, "last_shuttle": {"$ref": "#/$defs/hhmm"}}},
    "people": {"type": "array", "items": {"type": "object", "required": ["name", "role"],
                                          "properties": {"name": {"type": "string"}, "role": {"type": "string"}}}},
    "seating": {"type": "object", "required": ["front_row", "notes"],
                "properties": {"front_row": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}}},
    "catering": {"type": "object", "required": ["excluded_allergens", "menu", "dietary_counts"],
                 "properties": {
                   "excluded_allergens": {"type": "array", "items": {"type": "string"}},
                   "menu": {"type": "array", "items": {"type": "object", "required": ["course", "dish", "contains"],
                            "properties": {"course": {"type": "string"}, "dish": {"type": "string"},
                                           "contains": {"type": "array", "items": {"type": "string"}}}}},
                   "dietary_counts": {"type": "object", "required": ["vegetarian", "children"],
                                      "properties": {"vegetarian": {"type": "integer"}, "children": {"type": "integer"}}}}},
    "menu_cards": {"type": "object", "required": ["languages", "add_finnish_if_over"],
                   "properties": {"languages": {"type": "array", "items": {"type": "string"}},
                                  "add_finnish_if_over": {"type": ["integer", "null"]}}},
    "music": {"type": "object", "required": ["banned_songs"],
              "properties": {"banned_songs": {"type": "array", "items": {"type": "string"}}}},
    "photographer": {"type": "string"},
    "contingency": {"type": "object", "required": ["heat", "late_ceremony"],
                    "properties": {
                      "heat": {"type": "object", "required": ["threshold_celsius", "location"],
                               "properties": {"threshold_celsius": {"type": ["integer", "null"]},
                                              "location": {"type": ["string", "null"]}}},
                      "late_ceremony": {"enum": ["shorten_cocktails", "shorten_ceremony"]}}},
    "budget": {"type": "object", "required": ["cap_eur", "total_eur", "cut_order"],
               "properties": {"cap_eur": {"type": "number"}, "total_eur": {"type": "number"},
                              "cut_order": {"type": "array", "items": {"enum": ["fireworks", "interpreter", "flowers",
                                                                                 "photo_booth", "late_bar"]}}}},
    "venue_notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"hhmm": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}}
}
