{
  "type": "object",
  "required": ["event_name", "date", "delegate_count", "venue", "schedule", "speakers", "av", "photography",
               "catering", "rooms", "contingency", "budget"],
  "properties": {
    "event_name": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "delegate_count": {"type": "integer"},
    "venue": {"type": "object", "required": ["name", "coffee_location"],
              "properties": {"name": {"type": "string"}, "coffee_location": {"type": "string"}}},
    "schedule": {"type": "object", "required": ["keynote_start", "panel_start", "poster_session_start", "close"],
                 "properties": {"keynote_start": {"$ref": "#/$defs/hhmm"}, "panel_start": {"$ref": "#/$defs/hhmm"},
                                "poster_session_start": {"$ref": "#/$defs/hhmm"}, "close": {"$ref": "#/$defs/hhmm"}}},
    "speakers": {"type": "array", "items": {"type": "object", "required": ["name", "role"],
                                            "properties": {"name": {"type": "string"}, "role": {"type": "string"}}}},
    "av": {"type": "object", "required": ["contact", "aspect_ratio", "recorded_sessions", "streamed_sessions", "microphones"],
           "properties": {
             "contact": {"type": "string"}, "aspect_ratio": {"type": "string"},
             "recorded_sessions": {"type": "array", "items": {"type": "string"}},
             "streamed_sessions": {"type": "array", "items": {"type": "string"}},
             "microphones": {"type": "array", "items": {"type": "object", "required": ["speaker", "type"],
                             "properties": {"speaker": {"type": "string"},
                                            "type": {"enum": ["lapel", "handheld", "lectern"]}}}}}},
    "photography": {"type": "object", "required": ["flash_allowed"], "properties": {"flash_allowed": {"type": "boolean"}}},
    "catering": {"type": "object", "required": ["lunch_counts", "coffee_breaks"],
                 "properties": {
                   "lunch_counts": {"type": "object", "required": ["vegetarian", "halal", "gluten_free"],
                                    "properties": {"vegetarian": {"type": "integer"}, "halal": {"type": "integer"},
                                                   "gluten_free": {"type": "integer"}}},
                   "coffee_breaks": {"type": "array", "items": {"$ref": "#/$defs/hhmm"}}}},
    "rooms": {"type": "object", "required": ["overflow_booked", "book_overflow_if_over"],
              "properties": {"overflow_booked": {"type": "boolean"}, "book_overflow_if_over": {"type": ["integer", "null"]}}},
    "contingency": {"type": "object", "required": ["rail_strike_delay_minutes", "talk_overrun"],
                    "properties": {"rail_strike_delay_minutes": {"type": ["integer", "null"]},
                                   "talk_overrun": {"enum": ["shorten_coffee", "shorten_questions"]}}},
    "budget": {"type": "object", "required": ["cap_eur", "total_eur", "cut_order"],
               "properties": {"cap_eur": {"type": "number"}, "total_eur": {"type": "number"},
                              "cut_order": {"type": "array", "items": {"enum": ["dinner", "captioning", "printed_programme",
                                                                                 "swag", "photographer"]}}}}
  },
  "$defs": {"hhmm": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}}
}
